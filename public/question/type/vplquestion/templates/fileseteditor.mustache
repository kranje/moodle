{{!
    @template qtype_vplquestion/fileseteditor

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-role
    * data-direction
    * data-manylang

    Context variables required for this template:
    * listname An HTML ID prefix for the file list and file navigation.

    Example context (json):
    {
        "listname": "execfiles"
    }
}}
<em data-role="novplmessage" hidden="">{{# str}} selectavpl, qtype_vplquestion, #id_qvplbaseheader {{/ str}}</em>
<div id="{{listname}}navigation" hidden="">
    <div data-role="scrollerarrow" data-direction="left" class="clickable text-muted align-top mt-1 list-inline-item mx-0" aria-hidden="true">
        <i class="fa fa-fw fa-caret-left"></i>
    </div>{{!
    }}<div id="{{listname}}list" class="filelist inline-list" role="tablist"></div>{{!
    }}<div data-role="scrollerarrow" data-direction="right" class="clickable text-muted align-top mt-1 list-inline-item mx-0" aria-hidden="true">
        <i class="fa fa-fw fa-caret-right"></i>
    </div>
    <div class="ml-3 pl-1 mb-1" data-role="filemanagement">
        <label class="d-inline mr-3"><input type="radio" value="inherit" name="{{listname}}management" class="mr-1">{{# str}} inheritfromvpl, qtype_vplquestion {{/ str}}</label>
        <label class="d-inline mr-3"><input type="radio" value="overwrite" name="{{listname}}management" class="mr-1">{{# str}} overwriteexecfile, qtype_vplquestion {{/ str}}</label>
    </div>
</div>